      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "NVMe (самый горячий датчик)",
   "description": "Максимум по всем датчикам диска — обычно это контроллер (temp3).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by(instance)(node_hwmon_temp_celsius{chip=\"nvme_nvme0\"}) * on(instance) group_left(nodename) node_uname_info",
     "legendFormat": "{{nodename}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 65
       },
       {
        "color": "orange",
        "value": 72
       },
       {
        "color": "red",
        "value": 80
       }
      ]
     },
     "decimals": 1,
     "custom": {
      "lineWidth": 2,
