{
 "uid": "rpi-temps",
 "title": "RPi кластер — температуры",
 "tags": [
  "rpi",
  "hardware"
 ],
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "editable": true,
 "panels": [
  {
   "id": 1,
   "type": "gauge",
   "title": "CPU сейчас",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 16,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "node_thermal_zone_temp{type=\"cpu-thermal\"} * on(instance) group_left(nodename) node_uname_info",
     "legendFormat": "{{nodename}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 60
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 80
       }
      ]
     },
     "decimals": 1,
     "min": 30,
     "max": 90,
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "showThresholdMarkers": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Вентилятор (расчёт)",
   "description": "Оценка по кривой fan_control на rpi-1 (макс. CPU по 4 платам: ≤60→50%, 60–70→75%, >70→100%). Реальных оборотов нет — у вентилятора нет тахометра.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max(node_thermal_zone_temp{type=\"cpu-thermal\"})",
     "legendFormat": "fan",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 60.0001
       },
       {
        "color": "red",
        "value": 70.0001
       }
      ]
     },
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "range",
       "options": {
        "from": -100,
        "to": 60,
        "result": {
         "text": "50 %"
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 60.0001,
        "to": 70,
        "result": {
         "text": "75 %"
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 70.0001,
        "to": 1000,
        "result": {
         "text": "100 %"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Макс. CPU",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max(node_thermal_zone_temp{type=\"cpu-thermal\"})",
     "legendFormat": "max",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 60
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 80
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "CPU",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "node_thermal_zone_temp{type=\"cpu-thermal\"} * on(instance) group_left(nodename) node_uname_info",
     "legendFormat": "{{nodename}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 60
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 80
       }
      ]
     },
     "decimals": 1,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "NVMe (composite)",
   "description": "",
