  {
   "id": 8,
   "type": "timeseries",
   "title": "Частота CPU",
   "description": "Если частота падает при высокой температуре — это троттлинг.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
