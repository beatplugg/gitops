    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "avg by(instance)(node_cpu_scaling_frequency_hertz) * on(instance) group_left(nodename) node_uname_info",
